{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "/home/helen/nextbuild/types/**/*.ts",
    "/home/helen/nextbuild/dev/types/**/*.ts",
    ".build/types/**/*.ts",
    ".build/dev/types/**/*.ts",
    ".next-market-reviews-20261014/types/**/*.ts",
    ".next-market-reviews-20261014/dev/types/**/*.ts",
    ".next-market-review-names-20261014/types/**/*.ts",
    ".next-market-review-names-20261014/dev/types/**/*.ts",
    ".next-review-links-20261014/types/**/*.ts",
    ".next-review-links-20261014/dev/types/**/*.ts",
    ".next-reviews-fix-20261014/types/**/*.ts",
    ".next-reviews-fix-20261014/dev/types/**/*.ts",
    ".next-home-reviews12-20261014/types/**/*.ts",
    ".next-home-reviews12-20261014/dev/types/**/*.ts",
    ".next-all-visible-reviews-20261014/types/**/*.ts",
    ".next-all-visible-reviews-20261014/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
