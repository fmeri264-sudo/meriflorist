# База данных PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/meriflorist"

# Робокасса — получить на robokassa.ru
ROBOKASSA_MERCHANT_LOGIN="your_login"
ROBOKASSA_PASSWORD1="your_password1"
ROBOKASSA_PASSWORD2="your_password2"
ROBOKASSA_TEST_MODE="true"   # сменить на false в продакшне

# Яндекс Доставка — B2B API токен
YANDEX_DELIVERY_TOKEN="your_token"

# Яндекс Геокодер — для перевода адреса в координаты
YANDEX_GEOCODER_TOKEN="your_geocoder_token"

# Импорт отзывов Яндекс Маркета: API-Key с правами «Общение с покупателями»
YM_BUSINESS_ID="18473444"
YM_API_KEY=""
# Действующий OAuth-токен можно использовать вместо API-Key
YM_OAUTH_TOKEN=""

# Координаты вашего магазина (Санкт-Петербург)
WAREHOUSE_LAT="59.9311"
WAREHOUSE_LON="30.3609"

# URL сайта
NEXT_PUBLIC_SITE_URL="https://meriflorist.ru"
